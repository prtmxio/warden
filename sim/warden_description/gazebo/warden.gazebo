<?xml version="1.0"?>
<!-- Gazebo simulation plugins for warden -->
<!-- Auto-generated by meshflow from warden.urdf -->
<!--
  Include in xacro (uncomment when ready):
    <xacro:include filename="$(find warden_description)/gazebo/warden.gazebo"/>

  Detected: left=left_wheel_joint  right=right_wheel_joint
  separation=0.12m  diameter=0.06m
  sensor joints: []

  NOTE: If you uncomment base_footprint in the xacro,
  change robot_base_frame below from base_link to base_footprint.
-->
<robot>

  <!-- ═══════════════════════════════════════════════════
       DIFFERENTIAL DRIVE PLUGIN
       /cmd_vel → moves robot   /odom → odometry out
       ═══════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <!-- empty = global namespace → /cmd_vel /odom -->
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.12</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>
      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════
       JOINT STATE PUBLISHER
       → /joint_states so RSP can broadcast TF for moving joints
       ═══════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>left_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════
       SENSOR PLUGINS
       ═══════════════════════════════════════════════════ -->
  <gazebo reference="tof_sensor">
    <sensor name="depth_sensor" type="depth">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <pose>0 0 0 0.000000 1.570796 1.570796</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
      <plugin name="depth_tof_sensor" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/tof_sensor</namespace>
        </ros>
        <frame_name>tof_sensor_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <pose>0 0 0 3.141593 -0.000000 0.000000</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
      <plugin name="camera_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
        </ros>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>


  <!-- ═══════════════════════════════════════════════════
       FRICTION + MATERIAL per link
       ═══════════════════════════════════════════════════ -->
  <gazebo reference="base_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <gravity>true</gravity>
    <material>warden_description/base_link</material>
  </gazebo>

  <gazebo reference="right">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <material>warden_description/right</material>
  </gazebo>

  <gazebo reference="left">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <material>warden_description/left</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>warden_description/right_wheel_link</material>
  </gazebo>

  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>warden_description/caster</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>warden_description/left_wheel_link</material>
  </gazebo>

  <gazebo reference="tof_sensor">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>warden_description/tof_sensor</material>
  </gazebo>

  <gazebo reference="camera">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>warden_description/camera</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════
       PRESERVE FIXED JOINTS
       ═══════════════════════════════════════════════════ -->
  <gazebo reference="right_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="left_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="TOF_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="camera_jt">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="aruco_top">
    <material>warden_description/aruco_5</material>
  </gazebo>
  <gazebo reference="aruco_top_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>


</robot>
