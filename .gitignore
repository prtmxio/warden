# ── private / sensitive ───────────────────────────────────────────
CLAUDE.md
build_plan.md

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyo
.venv/
dist/
wheels/
*.egg-info/
.python-version
pyproject.toml
uv.lock

# ── ROS2 / colcon ─────────────────────────────────────────────────
build/
install/
log/
*.log

# ── Gazebo ────────────────────────────────────────────────────────
*.world.backup
# regenerated from Onshape tool, not hand-edited
/sim/urdf/meshes/*.stl

# ── ESP-IDF build artifacts (clangd index + pulled components) ─────
# .cache = IDE index; managed_components/ = deps restored from idf_component.yml
# + dependencies.lock; sdkconfig.old = backup written on sdkconfig change
bot_code/**/.cache/
bot_code/**/managed_components/
bot_code/**/sdkconfig.old

# ── Arduino / ESP32 ───────────────────────────────────────────────
bot_code/**/*.elf
bot_code/**/*.bin
bot_code/**/*.map
bot_code/**/*.hex

# ── ArUco marker PNGs ─────────────────────────────────────────────
# generated by aruco_gen.py, not source files
arena/markers/

# ── OS / editor dumps ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.orig

# ── data / debug dumps ────────────────────────────────────────────
*.bag
*.db3
*.mcap
frames.pdf
frames_*.pdf
frames_*.gv
scada.log
